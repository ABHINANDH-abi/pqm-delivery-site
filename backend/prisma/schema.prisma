// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Production Database Design
// Single-restaurant food delivery platform
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryPartnerStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?   @unique
  passwordHash   String
  role           UserRole  @default(CUSTOMER)
  isActive       Boolean   @default(true)
  isEmailVerified Boolean  @default(false)
  profileImageUrl String?

  // Relations
  addresses        Address[]
  orders           Order[]           @relation("CustomerOrders")
  deliveryProfile  DeliveryPartner?
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String  // e.g. "Home", "Work", "Other"
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  landmark     String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean @default(false)

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  // Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean @default(true)
  isVeg       Boolean @default(false)
  sortOrder   Int     @default(0)
  categoryId  String

  // Relations
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isVeg])
  @@map("products")
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PLACED)

  // Price fields — never recalculate from live product prices
  subtotal      Decimal @db.Decimal(10, 2)
  deliveryFee   Decimal @db.Decimal(10, 2) @default(0)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal @db.Decimal(10, 2)

  // Delivery address snapshot — stored separately from Address relation
  // so the order record is preserved even if the address is deleted
  deliveryAddressId   String?
  deliveryAddressText String  // Full address string snapshot at time of order

  notes String?

  // Driver Rating & Customer Feedback
  rating   Int?     // 1 to 5 stars
  feedback String?  // Review comment text

  // Customer
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)

  // Delivery address reference (optional — kept for reference, text snapshot is source of truth)
  deliveryAddress Address? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  // Delivery partner (assigned after READY status)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  // Relations
  items        OrderItem[]
  payment      Payment?
  notifications Notification[]

  // Timestamps for each status change
  acceptedAt      DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // Price snapshot — the exact values at time of order placement
  // These MUST NOT be recalculated from the live Product record
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DeliveryPartner {
  id                String                @id @default(cuid())
  userId            String                @unique
  vehicleType       String?               // e.g. "BIKE", "BICYCLE", "SCOOTER"
  vehicleNumber     String?
  licenseNumber     String?
  status            DeliveryPartnerStatus @default(OFFLINE)
  isVerified        Boolean               @default(false)
  currentLatitude   Float?
  currentLongitude  Float?
  totalDeliveries   Int                   @default(0)
  rating            Float?

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isVerified])
  @@map("delivery_partners")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)

  // Razorpay fields (populated when method = RAZORPAY)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  paidAt    DateTime?
  refundedAt DateTime?

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  orderId String?
  title   String
  body    String
  isRead  Boolean @default(false)

  // FCM token (populated when push notification is sent)
  fcmMessageId String?

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
