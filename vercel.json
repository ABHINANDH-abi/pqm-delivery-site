{
  "routes": [
    { "src": "/admin/assets/(.*)", "dest": "/landing-website/admin/assets/$1", "status": 200 },
    { "src": "/admin/(.*)", "dest": "/landing-website/admin/index.html", "status": 200 },
    { "src": "/admin", "dest": "/landing-website/admin/index.html", "status": 200 },
    { "src": "/app/assets/(.*)", "dest": "/landing-website/app/assets/$1", "status": 200 },
    { "src": "/app/(.*)", "dest": "/landing-website/app/index.html", "status": 200 },
    { "src": "/app", "dest": "/landing-website/app/index.html", "status": 200 }
  ]
}
