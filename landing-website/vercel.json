{
  "version": 2,
  "name": "qureshi-mandi-landing",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
