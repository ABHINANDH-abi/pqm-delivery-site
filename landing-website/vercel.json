{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin_index.html?v=1" },
    { "source": "/admin/(.*)", "destination": "/admin_index.html?v=1" },
    { "source": "/app", "destination": "/app_index.html?v=1" },
    { "source": "/app/(.*)", "destination": "/app_index.html?v=1" }
  ]
}
