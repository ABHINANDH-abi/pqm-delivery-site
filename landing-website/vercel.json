{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/admin", "destination": "/console/index.html" },
    { "source": "/admin/(.*)", "destination": "/console/index.html" },
    { "source": "/app", "destination": "/app-portal/index.html" },
    { "source": "/app/(.*)", "destination": "/app-portal/index.html" }
  ]
}
