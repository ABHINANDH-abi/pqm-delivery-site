{
  "routes": [
    { "src": "/admin/assets/(.*)", "dest": "/admin/assets/$1", "status": 200 },
    { "src": "/admin(.*)", "dest": "/admin/index.html", "status": 200 },
    { "src": "/app/assets/(.*)", "dest": "/app/assets/$1", "status": 200 },
    { "src": "/app(.*)", "dest": "/app/index.html", "status": 200 }
  ]
}
