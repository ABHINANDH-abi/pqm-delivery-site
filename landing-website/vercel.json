{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/admin_index", "destination": "/admin_index.html" },
    { "source": "/app_index", "destination": "/app_index.html" },
    { "source": "/admin", "destination": "/admin_index" },
    { "source": "/admin/(.*)", "destination": "/admin_index" },
    { "source": "/app", "destination": "/app_index" },
    { "source": "/app/(.*)", "destination": "/app_index" }
  ]
}
