{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin-app.html" },
    { "source": "/admin/(.*)", "destination": "/admin-app.html" },
    { "source": "/app", "destination": "/app-client.html" },
    { "source": "/app/(.*)", "destination": "/app-client.html" }
  ]
}
